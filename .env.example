# Local Supabase values are printed by: npm run db:start
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# One-time, existing-account-only owner bootstrap. This is never deployed.
BOOTSTRAP_OWNER_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_LOCALE=en
GENERATION_PROVIDER=template
PAYMENT_PROVIDER=test
SHARE_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Stripe-compatible provider (optional in local test-adapter mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BLUEPRINT_PRICE_ID=
STRIPE_COMPLETE_PRICE_ID=
STRIPE_COUNSELOR_PRICE_ID=

# iyzico hosted checkout (use sandbox values until your merchant account is live)
# Counselor subscriptions also require an active iyzico pricing-plan reference.
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_COUNSELOR_PRICING_PLAN_REFERENCE_CODE=
