{
  "name": "portfoliopath",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/unit/index.test.ts",
    "test:watch": "tsx --test --watch tests/unit/index.test.ts",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:start:lite": "supabase start -x studio,postgres-meta,realtime,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.ts",
    "bootstrap-owner": "tsx scripts/bootstrap-owner.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.7.1",
    "@react-pdf/renderer": "4.5.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.0",
    "@tanstack/react-table": "9.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.468.0",
    "next": "16.3.0",
    "next-intl": "4.13.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.84.0",
    "sonner": "2.0.7",
    "stripe": "22.4.0",
    "tailwind-merge": "3.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.2",
    "@playwright/test": "1.62.1",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "jsdom": "27.2.0",
    "supabase": "2.111.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.21.0",
    "typescript": "6.0.2"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
